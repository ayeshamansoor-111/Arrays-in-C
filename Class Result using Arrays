float computeAverage(int grades[], int a) {
    int sum = 0; 
    for (int i = 0; i < a; i++) {
    sum += grades[i]; 
    }
    return (float)sum / a; 
}
int findHighest(int marks[], int b) {
    int max = marks[0]; 
    for (int i = 0; i < b; i++) {
    if (marks[i] > max) {
        max = marks[i]; 
    } } 
   return max; 
} 
    int findLowest(int arr[], int d) {
        int min = arr[0]; 
        for (int i = 1; i < d; i++) {
         if (arr[i] < min) {
        min = arr[i]; 
    }
    }
   return min;
    } 
